---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import UsersGrid from "@/components/UsersGrid.astro";
import "@/styles/_users.css";

export const allUsers = await getCollection("users");
const title = Astro.locals.t("users.title");
const description = Astro.locals.t("users.description");
---

<StarlightPage
	frontmatter={{
		title,
		description,
		template: "splash",
		editUrl: false,
		hero: {
			tagline: description,
			title,
		},
	}}
>
	<div class="users-page">
		<section class="users-section">
			<UsersGrid users={allUsers} />
		</section>
	</div>
</StarlightPage>
