---
import { getImage } from "astro:assets";
import video from "@/assets/biome-promo.mp4";
import posterImage from "@/assets/biome-promo-poster.jpg";

const poster = await getImage({ src: posterImage, format: "webp" });
const label = Astro.locals.t("home.video.label");
---

<div class="promo-video">
	<video
		controls
		muted
		playsinline
		preload="none"
		poster={poster.src}
		width="1920"
		height="1080"
		aria-label={label}
		title={label}
	>
		<source src={video} type="video/mp4">
	</video>
</div>

<style>
.promo-video {
	max-width: 1100px;
	margin: 3rem auto 0;
}

.promo-video video {
	display: block;
	width: 100%;
	height: auto;
	aspect-ratio: 16 / 9;
	border: 1px solid var(--sl-color-gray-5);
	border-radius: 12px;
	background-color: #151515;
	box-shadow: 0 24px 60px rgb(0 0 0 / 0.35);
}
</style>
