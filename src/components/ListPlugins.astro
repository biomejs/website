---
import { getCollection } from "astro:content";
import { Icon } from "@astrojs/starlight/components";

const plugins = await getCollection("plugins");
---

<table>
	<thead>
		<tr>
			<th>Plugin name</th>
			<th>Description</th>
			<th>Useful links</th>
		</tr>
	</thead>
	<tbody>
		{plugins.map(plugin =>
		<tr>
			<td>
				<code>{plugin.data.id}</code>
			</td>
			<td>
				<p>{plugin.data.metadata.description}</p>
			</td>
			<td width="170">
				<ul>
					{plugin.data.metadata.website ? <li class="inline-icon"><a href={plugin.data.metadata.website} target="_blank" rel="noopener">Website
						<Icon name="external"/>
					</a></li> : ""}
				</ul>
				{plugin.data.metadata.repository ? <li class="inline-icon"><a href={plugin.data.metadata.repository} target="_blank" rel="noopener">Repository
					<Icon name="external"/>
				</a></li> : ""}

			</td>
		</tr>
	)}
	</tbody>
</table>
