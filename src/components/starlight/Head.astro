---
import { Font } from "astro:assets";

const { localized } = Astro.locals.starlightRoute.entry.data;
const head = Astro.locals.starlightRoute.head.filter(
	({ attrs }) => localized || attrs?.rel !== "alternate",
);
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<Font cssVariable="--font-geist" />
<Font cssVariable="--font-jetbrains-mono" />
