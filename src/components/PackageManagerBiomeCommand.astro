---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";

interface Props {
	command: string;
}

const { command } = Astro.props;
---

<Tabs syncKey="command">
	<TabItem label="npm" icon="seti:npm">
		<Code
			frame="none"
			showLineNumbers={false}
			code={`npx biome ${command}`}
			lang="bash"
		/>
	</TabItem>
	<TabItem label="pnpm" icon="pnpm">
		<Code
			frame="none"
			showLineNumbers={false}
			code={`pnpm biome ${command}`}
			lang="bash"
		/>
	</TabItem>
	<TabItem label="bun" icon="bun">
		<Code
			frame="none"
			showLineNumbers={false}
			code={`bunx biome ${command}`}
			lang="bash"
		/>
	</TabItem>
	<TabItem label="deno" icon="deno">
		<Code
			frame="none"
			showLineNumbers={false}
			code={`deno run -A npm:@biomejs/biome ${command}`}
			lang="bash"
		/>
	</TabItem>
	<TabItem label="yarn" icon="seti:yarn">
		<Code
			frame="none"
			showLineNumbers={false}
			code={`yarn biome ${command}`}
			lang="bash"
		/>
	</TabItem>
</Tabs>
