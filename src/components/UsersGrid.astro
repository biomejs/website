---
import type { CollectionEntry } from "astro:content";
import UserLogo from "@/components/UserLogo.astro";

interface Props {
	users: CollectionEntry<"users">[];
}

const { users } = Astro.props;
---

<div class="users-grid">
	{users.map((user) => (
		<div class="user-card" title={user.data.id}>
			<UserLogo
				user={user}
				size={64}
				class={user.data.logoSvg ? undefined : "raster-logo"}
			/>
			<span class="user-name">{user.data.id}</span>
		</div>
	))}
</div>

<style>
.users-grid {
	display: flex;
	flex-wrap: wrap;
	gap: 1.5rem;
	margin-bottom: 3rem;
	justify-content: center;
}

@media (min-width: 768px) {
	.users-grid {
		gap: 2rem;
	}
}

.user-card {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
	gap: 0.5rem;
	padding: 1rem;
	border-radius: 12px;
	box-sizing: border-box;
	margin: 0 !important;
	width: calc(50% - 0.75rem);
	min-width: 0;
	flex-shrink: 0;
}

@media (min-width: 768px) {
	.user-card {
		width: 170px;
		min-width: 170px;
		padding: 1.5rem;
		gap: 0.75rem;
	}
}

.user-card :global(img) {
	width: 100%;
	height: 48px;
	object-fit: contain;
	flex-shrink: 0;
	margin: 0;
}

/* GitHub avatars are square images with their own background */
.user-card :global(img.raster-logo) {
	width: 48px;
	border-radius: 8px;
}

@media (min-width: 768px) {
	.user-card :global(img) {
		height: 64px;
	}

	.user-card :global(img.raster-logo) {
		width: 64px;
	}
}

.user-name {
	font-size: 0.75rem;
	font-weight: 500;
	color: var(--sl-color-text);
	text-align: center;
	line-height: 1.4;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
	margin: 0;
}

@media (min-width: 768px) {
	.user-name {
		font-size: 0.875rem;
	}
}
</style>
