---
import LanguageSupportStatus from "./LanguageSupportStatus.astro";

type StatusId = "supported" | "experimental" | "inProgress" | "notStarted";

interface Props {
	title?: string;
	labels?: Partial<Record<StatusId, string>>;
}

const defaultLabels: Record<StatusId, string> = {
	supported: "Supported",
	experimental: "Experimental",
	inProgress: "In progress",
	notStarted: "Not started",
};

const { title = "Legend", labels = {} } = Astro.props;

const statuses = (Object.keys(defaultLabels) as StatusId[]).map((id) => ({
	id,
	label: labels[id] ?? defaultLabels[id],
}));
---

<ul class="language-support-legend not-content" aria-label={title}>
	{statuses.map(({ id, label }) => (
		<li>
			<LanguageSupportStatus status={id} decorative />
			<span class="label">{label}</span>
		</li>
	))}
</ul>

<style>
.language-support-legend {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem 1.5rem;
	margin: 0.75rem 0 0;
	padding: 0;
	list-style: none;
	color: var(--sl-color-gray-2);
	font-size: var(--sl-text-sm);
}

.language-support-legend li {
	display: inline-flex;
	align-items: center;
	gap: 0.375rem;
}

.label {
	font-weight: 500;
}
</style>
