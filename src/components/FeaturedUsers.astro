---
import { getCollection } from "astro:content";
import { LinkButton } from "@astrojs/starlight/components";
import UsersGrid from "@/components/UsersGrid.astro";

const allUsers = await getCollection("users");
const featuredUsers = allUsers.filter((user) => user.data.featured);
const title = Astro.locals.t("users.featured.title");
const description = Astro.locals.t("users.featured.description");
---

<div class="featured-users">
	<h2>{title}</h2>
	<p>{description}</p>
	<UsersGrid users={featuredUsers} />
	<LinkButton href="/users" style="margin: 0">
		View all users
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<title>View all users</title>
			<path d="M5 12h14"></path>
			<path d="m12 5 7 7-7 7"></path>
		</svg>
	</LinkButton>
</div>

<style>
.featured-users {
	margin: 4rem auto;
	padding: 0 1rem;
	text-align: center;
}
</style>
