---
import GitHubAvatar from "@/components/GitHubAvatar.astro";
import { getCollection } from "astro:content";

const maintainers = await getCollection("team", (entry) => {
	return entry.data.type === "core";
});
---

<ul class="credits-people-list core-contributors">
	{maintainers.map((entry) => (
		<li>
			<GitHubAvatar handle={entry.id} />
		</li>
	))}
</ul>
